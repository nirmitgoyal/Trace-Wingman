{
  "name": "sevak-dashboard-backend",
  "version": "1.0.0",
  "description": "Sevak Health Surveillance Dashboard - Backend",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "seed": "tsx src/seed/seed.ts",
    "seed:bulk": "tsx src/seed/seed_bulk.ts",
    "reclassify:cases": "tsx src/jobs/reclassify_cases.ts",
    "build:locations": "tsx src/scripts/build-location-data.ts",
    "build:locations:ct": "tsx src/scripts/build-location-data.ts --country=CT",
    "build:locations:tx": "tsx src/scripts/build-location-data.ts --country=TX",
    "build:locations:india": "tsx src/scripts/build-location-data.ts --country=IN",
    "test": "jest --forceExit --detectOpenHandles"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "mongoose": "^8.7.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.0.0",
    "jest": "^30.3.0",
    "ts-jest": "^29.4.9",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
